# Server Configurations
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL connection string for Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/siddhivinayak_db?schema=public"

# JWT Secrets (MANDATORY: Server will fail to start if these are missing or empty)
# Use strong 256-bit+ secret keys in production environments (e.g. openssl rand -base64 32)
JWT_SECRET="your_jwt_access_token_secret_here_make_it_long_and_secure"
JWT_REFRESH_SECRET="your_jwt_refresh_token_secret_here_make_it_long_and_secure"

# Cloudinary Storage Configurations
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Twilio Credentials (SMS OTP Delivery)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# 2Factor Transactional SMS & OTP Credentials
TWOFACTOR_API_KEY=""
TWOFACTOR_SENDER_ID="SSTOTP"
TWOFACTOR_OTP_TEMPLATE="SST_LOGIN_OTP"
TWOFACTOR_CUSTOMER_ORDER_TEMPLATE="SST_ORDER_CONFIRMED"
TWOFACTOR_ADMIN_ALERT_TEMPLATE="SST_ADMIN_ALERT"
TWOFACTOR_DISPATCH_TEMPLATE="SST_OUT_FOR_DELIVERY"
TWOFACTOR_DELIVERED_TEMPLATE="SST_DELIVERED"
ADMIN_ALERT_PHONE="9833607049"

# OTP Security & Rate Limiting Configurations (Optional: Defaults shown below)
OTP_EXPIRY_SECONDS=300            # OTP validity duration (default: 300 seconds = 5 minutes)
OTP_MAX_ATTEMPTS=5               # Maximum allowed failed attempts before lockout (default: 5)
OTP_LOCKOUT_MINUTES=60           # Duration of account lockout after repeated failures (default: 60 minutes)
OTP_RESEND_COOLDOWN_SECONDS=30   # Minimum delay required between consecutive OTP resends (default: 30 seconds)

# Production Security & Resource Limits
CORS_ORIGIN="http://localhost:5173,https://siddhivinayak-trading.vercel.app" # Comma-separated allowed frontend origins (or '*' in dev)
REQUEST_BODY_LIMIT="10mb"         # Maximum JSON / URL-encoded body payload size
MAX_FILE_SIZE_MB=10               # Maximum file upload size limit in MB
