# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/siddhivinayak?schema=public"

# Authentication Secrets
JWT_SECRET="your_jwt_secret_key_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"

# MiniMoth OTP Authentication
MINIMOTH_API_KEY="mm_live_xxxxxxxxxxxxxxxxxxxxxxxx"

# OTP Configuration
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=60
OTP_RESEND_COOLDOWN_SECONDS=30

# CORS & Upload Limits
CORS_ORIGIN="*"
REQUEST_BODY_LIMIT="10mb"
MAX_FILE_SIZE_MB=10
